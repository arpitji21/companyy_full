# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
DATABASE_URL=postgresql+psycopg://larkai:larkai@db:5432/larkai_orbit
DB_ECHO=false

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- CORS (comma-separated) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- S3 / object storage ---
S3_ENDPOINT_URL=
S3_BUCKET_NAME=larkai-orbit-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- File uploads / virus scanning (app/services/file_scanning.py) ---
MAX_UPLOAD_SIZE_MB=25
# Optional — uploads are still checked against the standard EICAR antivirus
# test signature with CLAMD_HOST unset. Set these to scan every upload
# against a real ClamAV daemon (e.g. the `clamav/clamav-debian:stable`
# container) in staging/production.
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=15

# --- Error tracking (Sentry) ---
# Optional — leave SENTRY_DSN blank to run with no error tracking (e.g. local
# dev, tests, CI). Set it to enable Sentry in staging/production.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# --- Email / SMTP (used by background tasks — password reset, email
# verification, approval-needed notices) ---
# Optional — leave SMTP_HOST blank to run with no email sending (e.g. local
# dev, tests, CI); the relevant Celery tasks just log and skip instead of
# erroring. Set it to send real mail in staging/production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAILS_FROM_EMAIL=no-reply@larkai-orbit.example.com
EMAILS_FROM_NAME=LarkAI Orbit

# Base URL of the frontend app — used to build links inside emails.
FRONTEND_URL=http://localhost:5173

# --- LLM providers (Phase 4: AI Agent System) ---
# Configure whichever you use — each is optional. An agent whose provider
# key is missing returns a graceful fallback message instead of erroring.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_REQUEST_TIMEOUT_SECONDS=60
DEFAULT_LLM_PROVIDER=openai
